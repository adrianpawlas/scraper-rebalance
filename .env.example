# ── Supabase ──────────────────────────────────────────────────────────────────
# For local development, copy this to .env and fill in your values.
# For GitHub Actions, set these as repository secrets:
#   Settings -> Secrets and variables -> Actions -> New repository secret
#   Name: SUPABASE_URL      Value: <your-supabase-url>
#   Name: SUPABASE_KEY      Value: <your-supabase-service-role-key>
#
# Get these from your Supabase project:
#   Project Settings -> API -> Project URL & service_role key

SUPABASE_URL=https://yqawmzggcgpeyaaynrjk.supabase.co
SUPABASE_KEY=

# ── Device ────────────────────────────────────────────────────────────────────
# Options: cpu, cuda, mps (auto-detected if left empty)
TORCH_DEVICE=cpu

# ── Scraping ──────────────────────────────────────────────────────────────────
SCRAPE_ALL=true
HTTP_CONCURRENCY=10
REQUEST_DELAY=0.5

# ── Paths ─────────────────────────────────────────────────────────────────────
CHECKPOINT_PATH=data/checkpoint.json
OUTPUT_PATH=data/products.json

# ── Database ──────────────────────────────────────────────────────────────────
DB_BATCH_SIZE=50
EMBEDDING_BATCH_SIZE=16
